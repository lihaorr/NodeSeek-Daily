# Default command is preview only, even when Cookie is configured.
NS_COOKIE=
# Numeric ID at the end of your own NodeSeek profile URL /space/12345.
NS_USER_ID=
NS_RANDOM=false
HEADLESS=true
# Optional: override the ten built-in comments; separate entries with |.
NS_COMMENT_TEXTS=
# Browser discovery only: default search term plus title-based synonym scanning.
# Optional extra terms cost additional site searches (at most five terms).
NS_SEARCH_KEYWORDS=抽奖
NS_SEARCH_PAGES=2
NS_RECENT_PAGES=5
NS_STATE_BACKEND=local
# CHROME_PATH=
